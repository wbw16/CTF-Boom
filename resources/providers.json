{
  "provider": {
    "mimo": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Xiaomi MiMo",
      "options": {
        "baseURL": "https://token-plan-cn.xiaomimimo.com/v1",
        "setCacheKey": true
      },
      "models": {
        "mimo-v2.5-pro": {
          "name": "MiMo V2.5 Pro",
          "limit": { "context": 300000, "output": 131072 },
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        "mimo-v2.5": {
          "name": "MiMo V2.5",
          "limit": { "context": 300000, "output": 131072 },
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        }
      }
    }
  }
}
